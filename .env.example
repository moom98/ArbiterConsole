# Arbiter Console - server environment (copy to .env.local; never commit real keys)
# ADR-007: Gemini is called only from the server Route Handlers (app/api/llm/*).
# Do NOT prefix these with NEXT_PUBLIC_ (that would expose them to the browser).

# Required for AI features (classification / AI reference for incidents not covered by decision trees)
GEMINI_API_KEY=

# Optional model overrides (defaults shown)
GEMINI_MODEL_REASONING=gemini-flash-latest
GEMINI_MODEL_CLASSIFIER=gemini-flash-lite-latest
