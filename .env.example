# Arbiter Console - server environment (copy to .env.local; never commit real keys)
# ADR-007: Gemini is called only from the server Route Handlers (app/api/llm/*).
# Do NOT prefix these with NEXT_PUBLIC_ (that would expose them to the browser).

# Required for AI features (classification / AI reference for incidents not covered by decision trees)
GEMINI_API_KEY=

# Optional model overrides (defaults shown)
GEMINI_MODEL_REASONING=gemini-flash-latest
GEMINI_MODEL_CLASSIFIER=gemini-flash-lite-latest

# Classification provider (ADR-011): gemini (default) | jev.
# Switch to jev only after the Japanese evaluation passes (jev-classifier-design §9).
LLM_CLASSIFIER_PROVIDER=gemini
# TypeSafe Jev key: required only when LLM_CLASSIFIER_PROVIDER=jev (also enables /api/llm/facts).
# Never commit it. For Workers use `npx wrangler secret put TYPESAFE_API_KEY`.
TYPESAFE_API_KEY=
# Pinned Jev model (thresholds depend on it; changing it requires re-running the evaluation)
JEV_MODEL=jev-1.13.0

# Optional thinking level: off | minimal | low | medium (default low)
GEMINI_THINKING_LEVEL=low
# Optional explicit thinking token budget (overrides the level for model families that use budgets)
GEMINI_THINKING_BUDGET=

# Access control for /api/llm/* (not the Gemini key).
# Clients send it in the X-Arbiter-Access-Token header (entered once on the device).
# REQUIRED in production: with NODE_ENV=production and no token, /api/llm/* returns 503.
LLM_ACCESS_TOKEN=
# Set to 1 only if the routes are protected by the platform (e.g. deployment password protection).
LLM_ALLOW_UNAUTHENTICATED=

# Abuse / cost guards (in-memory, per process). Also set Google Cloud quotas and a billing budget.
LLM_RATE_LIMIT_REASON_PER_MINUTE=10
LLM_RATE_LIMIT_CLASSIFY_PER_MINUTE=10
LLM_RATE_LIMIT_FACTS_PER_MINUTE=10
LLM_DAILY_REQUEST_LIMIT=500
# Semantic search embeddings (/api/llm/embed, ADR-010): separate rate limit and daily cap
LLM_RATE_LIMIT_EMBED_PER_MINUTE=60
LLM_DAILY_EMBED_REQUEST_LIMIT=1000
# Set to 1 only behind a proxy that overwrites X-Forwarded-For (e.g. Vercel)
TRUST_PROXY=
